# LinkedIn session cookie from a logged-in browser session.
# Get this by:
# 1. Log into LinkedIn in your browser
# 2. Open DevTools → Application → Cookies → www.linkedin.com
# 3. Copy the value of the "li_at" cookie
LI_AT_COOKIE=your_li_at_cookie_here

# OPTIONAL but REQUIRED for the public deployment: any caller to /profile must
# send `Authorization: Bearer <API_KEY>` (or `?key=<API_KEY>`). Leave empty only
# for local dev — an unkeyed public API lets anyone drive your LinkedIn cookies.
API_KEY=

# Full cookie jar for headless production (preferred over LI_AT_COOKIE alone).
# Either drop a cookies.json file ({name: value} for all linkedin.com cookies) in
# this directory, or set LINKEDIN_COOKIES to that JSON. See README "Production cookies".

